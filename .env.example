APP_NAME=NODIVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://nodiva.test
APP_TIMEZONE=Africa/Accra

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL only — SQLite is not supported by NODIVA.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nodiva
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS required)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Private disk used for clinical documents and qualification files (never "public")
NODIVA_CLINICAL_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nodiva.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- NODIVA platform configuration -------------------------------------------
NODIVA_DEFAULT_CURRENCY=GHS
NODIVA_DEFAULT_COUNTRY=GH
# Minutes a signed result download link stays valid
NODIVA_DOWNLOAD_LINK_TTL=5
# Require MFA for platform (operations) staff
NODIVA_REQUIRE_MFA_FOR_PLATFORM=false
# Require the result releaser to differ from the person who entered the result
NODIVA_RESULT_SEPARATION_OF_DUTIES=true
# Minimum group size for corporate aggregate reports (small-cell suppression)
NODIVA_MIN_AGGREGATE_CELL=5
# Payment provider adapter: "manual" (reconciliation-confirmed). No live gateway is configured.
NODIVA_PAYMENT_PROVIDER=manual
# Seed labelled demonstration data (never enable in production)
NODIVA_SEED_DEMO=true

VITE_APP_NAME="${APP_NAME}"
